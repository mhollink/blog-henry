---
import { getCollection, render } from "astro:content";
import config, { monolocale } from "$config";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import Position from "$components/Position.astro";
import Icon from "$components/Icon.svelte";
import Sensitive from "$components/Sensitive.svelte";
import i18nit from "$i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

export async function getStaticPaths() {
	// Get all berichten excluding drafts
	const berichten = await getCollection("bericht", bericht => !bericht.data.draft);

	return berichten.map(bericht => {
		let locale: string | undefined;
		let id: string;

		if (monolocale) {
			locale = undefined;
			id = bericht.id;
		} else {
			// Extract language and bericht ID from file path structure
			const [language, ...ids] = bericht.id.split("/");

			locale = config.i18n.defaultLocale === language ? undefined : language;
			id = ids.join("/");
		}

		// Generate path params with optional locale (omit for default locale)
		return { params: { locale, id }, props: { bericht } };
	});
}

const { locale = config.i18n.defaultLocale } = Astro.params;
const { bericht } = Astro.props;
const { Content, remarkPluginFrontmatter: frontmatter } = await render(bericht);

const t = i18nit(locale);
---

<Base title={bericht.data.title} {locale} description={bericht.data.description} article={{ timestamp: bericht.data.timestamp, tags: bericht.data.tags }}>
	<main class="flex flex-col gap-6">
		<header class="flex flex-col gap-4">
			<h1 class="select-text">{bericht.data.title}</h1>
			<div class="flex flex-col gap-3 sm:flex-row *:flex *:items-center *:gap-1 *:text-[0.875rem] *:text-secondary">
				<time datetime={bericht.data.timestamp.toISOString()}><Icon name="lucide--calendar" />{Time.toString(bericht.data.timestamp)}</time>
				{
					!!bericht.data.tags?.length && (
						<span>
							<Icon name="lucide--hash" />
							{bericht.data.tags?.join("; ")}
						</span>
					)
				}
				<span><Icon name="lucide--pilcrow" />{t("read.words", { count: frontmatter.words })}</span>
			</div>
			<hr class="border-b border-weak" />
		</header>

		<Sensitive {locale} back={getRelativeLocaleUrl(locale, "/bericht")} sensitive={bericht.data.sensitive} client:load>
			<section id="markdown-content" class="markdown"><Content /></section>
		</Sensitive>

		<Position {locale} />
	</main>
</Base>
